{
  "name": "vite-plugin-binary",
  "type": "module",
  "version": "1.3.0",
  "description": "Vite plugin for importing file in Uint8Array format",
  "author": "Yufan Sheng <syhily@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/syhily/vite-plugin-binary#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syhily/vite-plugin-binary.git"
  },
  "bugs": {
    "url": "https://github.com/syhily/vite-plugin-binary/issues"
  },
  "keywords": [
    "Vite",
    "base85",
    "fflate"
  ],
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.mjs",
      "require": "./dist/main.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    }
  },
  "main": "./dist/main.mjs",
  "module": "./dist/main.mjs",
  "types": "./dist/main.d.ts",
  "typesVersions": {
    "*": {
      "types": [
        "dist/types.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "index.d.ts"
  ],
  "scripts": {
    "build": "tsdown && cp src/types.d.ts dist/",
    "dev": "vite",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "fflate": "^0.8.2",
    "tsdown": "^0.22.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.11"
  },
  "packageManager": "npm@11.14.1"
}
